BFX_PROD_FULL_API_KEY=your_bfx_api_key_here
BFX_PROD_FULL_API_SECRET=your_bfx_api_secret_here

# Mobile Next Cloud (MW_CLOUD=1)
MOBILENEXT_API_KEY=your_mobilenext_api_key_here

# BrowserStack App Automate (BROWSERSTACK=1)
BROWSERSTACK_USERNAME=your_browserstack_username_here
BROWSERSTACK_ACCESS_KEY=your_browserstack_access_key_here
# Optional: a pre-uploaded app id (bs://<app-id>). Avoids re-uploading the
# ~290MB APK on every run. Falls back to app/android/*.apk when unset.
BROWSERSTACK_APP=bs://your_app_id_here
# Optional device selection (deviceName is matched as a regex)
# BROWSERSTACK_DEVICE=Google Pixel 8
# BROWSERSTACK_OS_VERSION=>=13 <15
# BROWSERSTACK_BUILD=my-build-name
